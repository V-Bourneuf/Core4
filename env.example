# Okta Demo Platform — Environment Configuration
# Copy this to .env and fill in your values

# Your Okta tenant URL (e.g., https://your-org.okta.com or https://your-org.oktapreview.com)
VITE_OKTA_ORG_URL=https://your-tenant.okta.com

# Okta API Token (Admin > Security > API > Tokens)
# Required scopes: okta.users.read, okta.apps.read, okta.logs.read, okta.policies.read, okta.groups.read
VITE_OKTA_API_TOKEN=your-api-token-here

# Proxy server port (optional, default 3001)
PROXY_PORT=3001
